# A/B attribution of FLake's lake->soil nudging. Identical in every respect to
# its partner config except NAMELIST_TEMPLATE, so any difference in the output
# is attributable to TMNW_NDG_TIMESCL alone -- unlike a Y2001-vs-Y2000
# comparison, which confounds the switch with interannual variability.
# Nudging: on.  2001-01-01 00 -> 2001-04-01 00 (90 days), seeded from Y2000.
# NOT archived to ECFS: diagnostic, not a campaign segment.
START_DATE=2001-01-01T00:00:00
N_HOURS=2160
NFORCWINDOW=744
OUTPUT_FREQ_HOURS=24
OMP_NUM_THREADS=8
STA=ABFLAKEON_20010101-20010401
FORCING_SOURCE=${SLURM_SUBMIT_DIR}/forcing/WFDE5_CRU_GPCC/WFDE5_CRU_GPCC_2001.nc
CMF_WEIGHTS_DIR=${SLURM_SUBMIT_DIR}/cama_flood/work_global_weights/glb_15min_out_n16
RESTART_FROM=${SLURM_SUBMIT_DIR}/run/output/Y2000_20000101-20010101/restartout.nc
NAMELIST_TEMPLATE=${SLURM_SUBMIT_DIR}/namelist/templates/namelist_ecland_50R1_cmf_nudge_on
