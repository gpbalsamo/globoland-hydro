# Milestone 3 stage 3, re-run: full year 1988, coupled, with
#  - the C4 photosynthesis fix (ecland develop 13d5d00)
#  - daily output: ~20 GB/year instead of 424 GB, which is what killed the
#    first attempt (SIGBUS on the final write of a 424 GB o_gg.nc)
#  - ECFS archiving, so the campaign does not accumulate on PERM
# 1988 is a LEAP year: 366*24 = 8784.
START_DATE=1988-01-01T00:00:00
N_HOURS=8784
NFORCWINDOW=744
OUTPUT_FREQ_HOURS=24
OMP_NUM_THREADS=8
STA=Y1988_19880101-19890101
FORCING_SOURCE=${SLURM_SUBMIT_DIR}/forcing/WFDE5_CRU_GPCC/WFDE5_CRU_GPCC_1988.nc
CMF_WEIGHTS_DIR=${SLURM_SUBMIT_DIR}/cama_flood/work_global_weights/glb_15min_out_n16
ECFS_DIR=ec:/pad/wfde5-ecland
