# Full-year 1988 coupled ecLand <-> CaMa-Flood run (Milestone 3, stage 3:
# one day -> one month -> one year). Sourced by run/run_ecland_cmf.slurm;
# see that script for why settings arrive as a file rather than via the
# environment.

STA=GLOBALCMF_19880101-19890101
START_DATE=1988-01-01T00:00:00

# 1988 is a LEAP year: 366*24 = 8784, not 8760. Getting this wrong
# truncates the run by a day and desyncs any restart chained after it.
N_HOURS=8784

# One month of forcing resident at a time. Without this, GFOR is
# NPOI*NDFORC*12*8 = 87798*8784*12*8 ~= 74 GB and the run cannot start.
# Must be 0 or >= 8; requires ecLand's NFORCWINDOW support.
NFORCWINDOW=744

# The full-year assembled file, NOT run_ecland.sh's single-month default.
FORCING_SOURCE=${SLURM_SUBMIT_DIR}/forcing/WFDE5_CRU_GPCC/WFDE5_CRU_GPCC_1988.nc
