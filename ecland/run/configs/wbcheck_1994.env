# ecLand's own per-grid-point water-balance check (LEWBCHECK=.TRUE.), ONE DAY.
#
# Purpose: settle whether the -2670 Gt/yr imbalance concentrated on lake-bearing
# cells is a real model leak or an artefact of reconstructing the budget from
# output files. The model's internal check is authoritative; the offline
# diagnostic in validation/check_budgets.py is not.
#
# ONE DAY on purpose. The check's trigger threshold is ~machine epsilon and each
# failing point prints ~25 lines per timestep; a year could produce an
# absurd log. Check the size before extending this.
#
# Seeded from the Y1993 restart so it reproduces the start of the 1994 segment
# exactly -- 1994 is the worst year in the sweep (1.069%).
START_DATE=1994-01-01T00:00:00
N_HOURS=24
NFORCWINDOW=0
OUTPUT_FREQ_HOURS=1
OMP_NUM_THREADS=8
STA=WBFIRN_19940101-19940102
FORCING_SOURCE=${SLURM_SUBMIT_DIR}/forcing/WFDE5_CRU_GPCC/WFDE5_CRU_GPCC_1994.nc
CMF_WEIGHTS_DIR=${SLURM_SUBMIT_DIR}/cama_flood/work_global_weights/glb_15min_out_n16
RESTART_FROM=${SLURM_SUBMIT_DIR}/run/output/Y1993_19930101-19940101/restartout.nc
NAMELIST_TEMPLATE=${SLURM_SUBMIT_DIR}/namelist/templates/namelist_ecland_50R1_cmf_wbcheck
VERIFY_RESTART=false
