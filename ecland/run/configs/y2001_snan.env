# Diagnostic run: hunt the 2001 FPE with -init=snan (uninitialised reads trap
# at the READ, with -g -traceback giving the line). Output is switched OFF --
# OUTPUT_FREQ_HOURS large enough that NFRPOS exceeds NSTOP, so no
# post-processing write ever happens. At -O0 the output path and its
# mpl_allgatherv are a large share of the runtime and are irrelevant to this
# bug, so this gets to step 8912 considerably faster.
START_DATE=2001-01-01T00:00:00
N_HOURS=8760
NFORCWINDOW=744
OUTPUT_FREQ_HOURS=100000
OMP_NUM_THREADS=8
STA=Y2001SE_20010101-20020101
FORCING_SOURCE=${SLURM_SUBMIT_DIR}/forcing/WFDE5_CRU_GPCC/WFDE5_CRU_GPCC_2001.nc
CMF_WEIGHTS_DIR=${SLURM_SUBMIT_DIR}/cama_flood/work_global_weights/glb_15min_out_n16
RESTART_FROM=${SLURM_SUBMIT_DIR}/run/output/Y2000_20000101-20010101/restartout.nc
# optimised binary: ~31 min to the crash with output off
