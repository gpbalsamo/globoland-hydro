# Re-measure LWEVAP now the DROFUNIT unit bug is fixed. The previous result
# ("recovers 0.1% of lake evaporation") was taken when floodplain storage was
# 24x too small, so the extraction was storage-limited by the bug itself and
# the number was meaningless. The comparison arm is v4's own Y1994 segment,
# which has LWEVAP=false and the correct DROFUNIT=3600.
START_DATE=1994-01-01T00:00:00
N_HOURS=8760
NFORCWINDOW=744
OUTPUT_FREQ_HOURS=24
OMP_NUM_THREADS=8
STA=LWEVAPV4_19940101-19950101
FORCING_SOURCE=${SLURM_SUBMIT_DIR}/forcing/WFDE5_CRU_GPCC/WFDE5_CRU_GPCC_1994.nc
CMF_WEIGHTS_DIR=${SLURM_SUBMIT_DIR}/cama_flood/work_global_weights/glb_15min_out_n16
RESTART_FROM=${SLURM_SUBMIT_DIR}/run/output/Y1993_19930101-19940101/restartout.nc
NAMELIST_CMF_TEMPLATE=${SLURM_SUBMIT_DIR}/namelist/templates/namelist_cmf_global_wevap.tmpl
VERIFY_RESTART=true
