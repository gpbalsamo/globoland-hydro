# A/B on CaMa-Flood's LWEVAP switch, full year 1994.
#
# The OFF case already exists: the archived Y1994_19940101-19950101 segment was
# run with the production template, which has LWEVAP=false. This config is the
# ON case, identical in every other respect (same forcing, same Y1993 restart,
# same weights, same output frequency), so any difference is attributable to
# LWEVAP alone.
#
# What we are measuring:
#   1. total D2WEVAPEX over the year, against the ~2670 Gt of lake evaporation
#      that currently has no source -> what fraction of the closure path is
#      actually reachable;
#   2. the change in discharge (totout), since extracting water from floodplain
#      storage necessarily reduces it. That matters because all 37 archived
#      years were run with LWEVAP=false.
#
# NOT archived to ECFS: diagnostic, not a campaign segment.
START_DATE=1994-01-01T00:00:00
N_HOURS=8760
NFORCWINDOW=744
OUTPUT_FREQ_HOURS=24
OMP_NUM_THREADS=8
STA=LWEVAPON94_19940101-19950101
FORCING_SOURCE=${SLURM_SUBMIT_DIR}/forcing/WFDE5_CRU_GPCC/WFDE5_CRU_GPCC_1994.nc
CMF_WEIGHTS_DIR=${SLURM_SUBMIT_DIR}/cama_flood/work_global_weights/glb_15min_out_n16
RESTART_FROM=${SLURM_SUBMIT_DIR}/run/output/Y1993_19930101-19940101/restartout.nc
NAMELIST_CMF_TEMPLATE=${SLURM_SUBMIT_DIR}/namelist/templates/namelist_cmf_global_wevap.tmpl
VERIFY_RESTART=true
