# Full-year 1994 with the ZROFS ice-calving fix, to quantify what the fix
# changes in the water budget and in discharge. The comparison arm is the
# archived Y1994 segment (same forcing, same Y1993 restart, same weights,
# same daily output) run before the fix.
START_DATE=1994-01-01T00:00:00
N_HOURS=8760
NFORCWINDOW=744
OUTPUT_FREQ_HOURS=24
OMP_NUM_THREADS=16
STA=BOTHFIX94_19940101-19950101
FORCING_SOURCE=${SLURM_SUBMIT_DIR}/forcing/WFDE5_CRU_GPCC/WFDE5_CRU_GPCC_1994.nc
CMF_WEIGHTS_DIR=${SLURM_SUBMIT_DIR}/cama_flood/work_global_weights/glb_15min_out_n16
RESTART_FROM=${SLURM_SUBMIT_DIR}/run/output/Y1993_19930101-19940101/restartout.nc
VERIFY_RESTART=true
