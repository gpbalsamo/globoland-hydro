! DAMS configuration -- identical to namelist_cmf_global.tmpl except that
! CaMa-Flood's reservoir scheme is ON, with year-by-year commissioning.
! The naturalised control is the v4 archive (ec:/pad/wfde5-ecland-v4),
! which is this file with LDAMOUT=.FALSE.
!
! dam_params.csv is built by cama_flood/dams/estimate_dam_params.py from
! v4's own discharge: Gumbel (L-moments) on 37 annual maxima at each dam
! cell -> Q100 -> Qf = 0.3*Q100, Qn = mean flow, FldVol/ConVol split 37/63
! of GRanD capacity. 3697 cells from 3982 GRanD dams allocated to the
! glb_15min network -- 285 dams share a cell with another and are MERGED
! (capacities added, 6642.7 km3 preserved exactly), because CaMa is
! one-dam-per-cell and would otherwise silently drop the shadowed ones.
! The 3127 sub-grid GRanD dams are excluded: every one has area_CaMa=-888
! (no drainage-area match), so upreal -- which the H22 rule divides by --
! cannot be supplied without inventing it. They are 3.3% of capacity.
!
! CAVEATS to carry into any analysis: a 100-year return period is being
! extrapolated from 37 annual maxima, and Qf = 0.3*Q100 is CaMa's own
! convention, not something validated here.
! Global CaMa-Flood coupling namelist, generalised from ecland's own
! official GLOBAL coupled test reference,
! /perm/pad/ecland/tests/ifsbench/namelist_cmf_2d_gl_t21 (ecland VERSION
! 2.0.0, tests/ifsbench/test_2d_gl_t21.yaml -- a T21-grid coupled test,
! job.tasks=2, i.e. real MPI). That reference targets a coarse T21
! reduced-Gaussian atmospheric grid; this repo's own ecLand grid is a
! different, unrelated choice (360x720 global 0.5 deg regular lat-lon,
! per docs/grid_strategy.md's own principle that CaMa-Flood routing
! resolution and ecLand runoff-generation resolution are independent
! concerns) -- only the NAMELIST STRUCTURE and the settings NOT tied to a
! specific grid are carried over unchanged; everything file-path- or
! date-related is this repo's own.
!
! Rendered by ecland's own share/ecland/scripts/ecland_create_namelist.py
! (-c this file), which fills in {yy}/{mm}/{dd}/{yye}/{mme}/{dde} from the
! actual ecLand-side forcing file's own start/end dates -- see
! run/run_ecland.sh. Everything else here is literal, not derived
! (build_global_cmf_fixdir.sh's / derive_global_cmf_weights.sh's real
! output paths, and DT/IFRQ_INP matching this repo's own TCOUPFREQ=1 hour
! in namelist/templates/namelist_ecland_50R1_cmf -- hourly coupling,
! matching real ECMWF operational configuration per explicit request,
! 2026-09-20).
!
! DROFUNIT/CROFCDF/CVNROF/CVNSUB below: kept EXACTLY as the official T21
! reference has them, but now CONFIRMED (2026-09-20, by reading
! src/surf/cmflood.cmake + src/surf/offline/cmfld1s.F90 +
! src/surf/offline/driver/cnt41s.F90 directly) to be dead/unused in this
! executable. `CMF_FORCING_GET` (the routine that reads CROFCDF/the
! CROFDIR binary-file path) is called ONLY from cmfld1s.F90, a SEPARATE,
! standalone CaMa-Flood-only driver compiled into a DIFFERENT executable
! (ecland-master-cmflood-dp, despite its name -- see run/run_ecland.sh's
! own comment). The online-coupled executable this repo actually uses
! (plain ecland-master-dp, built from master1s.F90) calls
! CMF_FORCING_PUT + CMF_DRV_ADVANCE directly from cnt41s.F90, in-memory,
! and never reaches CMF_FORCING_GET at all. Confirmed by a real crash
! (ecland-master-cmflood-dp trying and failing to open
! ./runoff/Roff____19880101.one) before this was understood.

&NRUNVER
LADPSTP=.TRUE.
LFPLAIN=.TRUE.
LKINE=.FALSE.
LFLDOUT=.TRUE.
LPTHOUT=.TRUE.
LDAMOUT  = .TRUE.
LROSPLIT=true
LWEVAP=false
LWEVAPFIX=.FALSE
LWEXTRACTRIV=FALSE
LGDWDLY=false
LSLPMIX=.FALSE.
LMEANSL=.FALSE.
LSEALEV=.FALSE.
! LRESTART below is the COLD-START default and is PATCHED TO .TRUE. by
! run/run_ecland.sh whenever CMF_RESTART_FROM is set (which submit_campaign.py
! does for every segment after the first). Do not read the literal value here
! as what a campaign segment actually ran with -- check the rendered namelist,
! or the "LRESTART" line in the run's own log_CaMa.txt-<rank>.
!
! This file hardcoded LRESTART=false and nothing staged a CaMa restart until
! 2026-10-10, so all 37 segments of both campaigns cold-started CaMa with an
! empty river network while ecLand chained correctly. See PLAN.md.
LRESTART=false
LSTOONLY=false
LOUTPUT=.TRUE.
LGRIDMAP=.TRUE.
LLEAPYR=.TRUE.
LMAPEND=.FALSE.
LBITSAFE=.TRUE.
LSLOPEMOUTH=.FALSE.
/

&NDAMOUT
CDAMFILE = "/perm/pad/wfde5-ecland/cama_flood/dams/dam_params.csv"   ! per-cell dam parameters
LDAMTXT  = .TRUE.                     ! write the dam diagnostic text output
LDAMH22  = .FALSE.                    ! Yamazaki&Funato rule (H22 needs reliable upreal)
LDAMYBY  = .TRUE.                     ! year-by-year commissioning from DamYear
LiVnorm  = .TRUE.
/
&NDIMTIME
CDIMINFO = "diminfo.txt"
DT       =  3600   ! seconds -- must equal TCOUPFREQ (hours) * 3600
IFRQ_INP = 1        ! hours -- matches TCOUPFREQ=1 (hourly coupling)
/
&NPARAM
PMANRIV  = 0.03D0
PMANFLD  = 0.10D0
PGRV     = 9.8D0
PDSTMTH  = 25000.D0
PCADP    = 0.7
PMINSLP  = 1.D-5
IMIS     = -9999
RMIS     = 1.E20
DMIS     = 1.E20
CSUFBIN  = '.bin'
CSUFVEC  = '.vec'
CSUFPTH  = '.pth'
CSUFCDF  = '.nc'
/
&NSIMTIME
SYEAR={yy}
SMON={mm}
SDAY={dd}
SHOUR=00
EYEAR={yye}
EMON={mme}
EDAY={dde}
! EHOUR is the END hour of the CaMa integration and also names the restart
! file ecland_run_model.sh moves (restart<EYEAR><EMON><EDAY><EHOUR>.nc).
! Segments now run 00:00 1 Jan -> 00:00 1 Jan of Y+1, so the last forcing
! record (and hence {yye}/{mme}/{dde}) is 1 Jan of Y+1 at hour 00, NOT
! 31 Dec at hour 23. Leaving this at 23 would make CaMa integrate an extra
! 23 h past the forcing and look for a restart file that was never written.
EHOUR=00
/
&NMAP
LMAPCDF=.TRUE.
CPTHOUT="__CAMA_BIFPRM__"
CRIVCLINC="__CAMA_RIVCLIM__"
CRIVPARNC="__CAMA_RIVPAR__"
CMPIREGNC="__CAMA_MPIREG__"
/
&NRESTART
CRESTDIR="./"
CRESTSTO=""
! netCDF restarts, not the T21 reference's plain-binary default: aligned
! with what ECMWF operations does, and it also happens to fix a real
! mismatch -- ecland_run_model.sh's cleanup hardcodes
! `mv restart<YYYYMMDDHH>.nc`, so with LRESTCDF=.FALSE. CaMa wrote
! restart1988013123.bin (+ .bin.pth) and that mv failed at the very end of
! an otherwise fully successful month-long run (2026-09-20).
LRESTCDF=.TRUE.
CVNREST="restart"
IFRQ_RST=0
/
&NFORCE
LINPCDF=false
LINTERP=true
LINPEND  = .FALSE.
LITRPCDF = .TRUE.
CINPMAT  ="__CAMA_INPMAT__"
! DROFUNIT converts the incoming runoff to m3/m2/s: CaMa divides by it
! (cmf_ctrl_forcing_mod.F90:782,813). ecLand hands over runoff accumulated as
! METRES OVER ONE COUPLING INTERVAL -- cnt41s.F90:218 adds
! D1STSRO2*TSTEP*0.001 each step and zeroes the buffer after every handover
! (cnt41s.F90:364). So DROFUNIT MUST EQUAL TCOUPFREQ*3600, the interval in
! seconds. With TCOUPFREQ=1 that is 3600.
!
! This was 86400, inherited from the official T21 reference, which couples
! 12-hourly. Hourly coupling with a daily divisor made ALL routed discharge
! 24x too small: Amazon 6,022 m3/s against ~175,000 observed; applying the
! factor 24 recovers 144,500 (Amazon), 36,700 (Congo), 18,100 (Mississippi)
! against ~175,000 / ~41,000 / ~17,000. The land-side water budget was never
! affected -- ecLand's own runoff is correct.
! NB the T21 reference itself has TCOUPFREQ=12 with DROFUNIT=86400, i.e. the
! same inconsistency at 2x. run/run_ecland.sh now asserts the relation.
DROFUNIT =3600.
CROFCDF="runoff.nc"
CVNROF   = "Qs"
CVNSUB   = "Qsb"
SYEARIN={yy}
SMONIN={mm}
SDAYIN={dd}
SHOURIN=00
/
&NOUTPUT
COUTDIR="__CAMA_OUTDIR__"
CVARSOUT="rivsto,fldsto,totout,rivdph,damsto,daminf"
COUTTAG=""
LOUTVEC=.FALSE.
LOUTCDF=.TRUE.
NDLEVEL=0
! IFRQ_OUT is CaMa's own output-write frequency, a SEPARATE setting from
! IFRQ_INP (coupling frequency) above -- hourly *output* over a full month
! (744 steps x 4 vars x 720x1440) pushed this run to ~17.8 GiB resident and
! got OOM-killed by the job's memory cgroup (confirmed 2026-09-20). Keep
! coupling itself hourly (matches the operational configuration this is
! meant to mimic) but write output daily -- this is a reporting-granularity
! choice, not part of "does it mimic operations".
IFRQ_OUT = 24       ! hours
/
