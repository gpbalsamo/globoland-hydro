# Python
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Large / generated scientific data -- never committed.
# Small, curated, hand-checked reference files are the explicit exceptions
# below (e.g. namelist templates, tiny test fixtures) -- add further
# exceptions there, not by removing rules here.
*.nc
*.nc4
*.grib
*.grb
*.grb1
*.grb2
*.zarr/
*.bin
*.npz

# ... except tiny synthetic test fixtures, explicitly curated and reviewed.
!tests/fixtures/**/*.nc

forcing/data/
# CDS scratch: download_wfde5.py's --raw-dir. The extracted members are
# *.nc (already covered above) but the in-flight *.download / *.zip are
# not, and a single year is ~20 GB.
forcing/WFDE5_CRU_GPCC_cds_raw/
*.download
init_clim/work/
init_clim/output/
run/output/
run/output_*/
run/restart/
run/work/
run/bin/
run/bin_*/
run/lib64/
run/lib64_*/
cama_flood/work/
cama_flood/work_*/
experiments/*/output/
experiments/*/restart/
experiments/*/work/

# Benchmark run artifacts (scripts/benchmark.py) -- generated per run,
# never committed. See docs/benchmark_contract.md.
reports/

# Logs and scheduler output
*.log
*.out
*.err
slurm-*.out
# ECMWF's sbatch wrapper drops one of these in the submit directory per
# submission -- 153 of them accumulated during the 1988-2024 campaign, which
# buries real changes in `git status` and makes `git status` before a commit
# (a rule in CLAUDE.md) useless in practice.
ecsbatch.log.*

# Credentials -- never, under any circumstance.
.cdsapirc
*cdsapirc*
.netrc
*api_key*
*apikey*
*credentials*
*.pem
*.key
!config/paths.example.yaml

# Machine-specific config (real paths.yaml belongs on the machine, not in git;
# only paths.example.yaml with placeholder values is committed).
config/paths.yaml

# Temporary files
*.tmp
*.bak
*~
.DS_Store

# Synthetic one-record boundary stub for the final archive year (generated by
# forcing/make_boundary_stub.py). Regenerate rather than commit.
forcing/WFDE5_CRU_GPCC/WFDE5_CRU_GPCC_2025.nc
